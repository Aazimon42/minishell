#include "../includes/minishell.h"

void	replace_env(t_envar *head, char *name, char *value)
{
	while (head)
	{
		if (!ft_strcmp(head->name, name))
		{
			free(head->value);
			head->value = value;
		}
		head = head->next;
	}
}

void	delete_env(t_envar *head, char *name)
{
	t_envar	*tmp;

	tmp = head;
	while (tmp)
	{
		if (!ft_strcmp(tmp->name, name))
		{
			head->next = tmp->next;
			free(tmp->value);
			free(tmp->name);
			free(tmp);
			break ;
		}
		head = tmp;
		tmp = tmp->next;
	}
}

